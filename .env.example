NEXT_PUBLIC_APP_NAME=Sidekicks

# Control plane
SIDEKICKS_BACKEND=postgres
DATABASE_URL=postgresql://sidekicks:sidekicks@postgres:5432/sidekicks
REDIS_URL=redis://redis:6379
CONTROL_PLANE_URL=http://web:3000

# Artifact storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=sidekicks-artifacts
S3_ACCESS_KEY=sidekicks
S3_SECRET_KEY=sidekickspassword

# Worker defaults
WORKER_QUEUE=sidekicks-runs
WORKER_RUNTIME=node
